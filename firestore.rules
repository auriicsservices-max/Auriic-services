rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : {};
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'darshanwala894@gmail.com' || 
        request.auth.token.email == 'auriicsservices@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'team_leader'])
      );
    }

    function isTeamLeader() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'team_leader';
    }

    function isTeamMember() {
      return isSignedIn() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['team_leader', 'recruiter'] && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isArchived', false) == false
        )
      );
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Collection Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      
      function isValidUser(data) {
        return data.uid is string && 
               data.email is string && 
               data.role in ['admin', 'team_leader', 'recruiter'];
      }

      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Support updating own profile or status/readCursors
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Invitations for pre-registration
    match /invitations/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Candidate Collection Rules
    match /candidates/{candidateId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Notifications Collection Rules
    match /notifications/{notificationId} {
      allow list: if isSignedIn() && (
        getUserData().role in ['admin', 'team_leader'] || 
        resource.data.recipientId == request.auth.uid ||
        resource.data.recipientId == 'all'
      );
      allow read: if isSignedIn() && (
        getUserData().role in ['admin', 'team_leader'] || 
        resource.data.recipientId == request.auth.uid ||
        resource.data.recipientId == 'all'
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // Add ownership verification here later if needed
    }

    // Training CV Collection Rules
    match /training_cvs/{cvId} {
      allow read, write: if isAdmin();
    }

    // Activity Logs Collection Rules
    match /activity_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    // Chat Message Rules (Global)
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Direct Message Rules (DM)
    match /direct_messages/{messageId} {
      // Allow read if user is sender, recipient, or in participants list
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        resource.data.get('participants', []).hasAny([request.auth.uid])
      );
      
      // Allow create if user is sender and part of participants
      allow create: if isSignedIn() && (
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.get('participants', []).hasAny([request.auth.uid])
      );
      
      allow delete: if isAdmin();
    }

    // Typing State Rules
    match /typing_states/{conversationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Global Settings Rules
    match /settings/global {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
